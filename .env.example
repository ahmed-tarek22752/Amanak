# Core settings
APP_NAME=Amanak
ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./amanak.db
SECRET_KEY=change-me

# Feature flags
ENABLE_WHATSAPP=false
ENABLE_VOICE=false
ENABLE_FAMILY_ALERT=false
ENABLE_AI=false

# Telegram
TELEGRAM_TOKEN=your_telegram_bot_token_here
TELEGRAM_WEBHOOK_URL=

# WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# AI
ANTHROPIC_API_KEY=
AI_MODEL=claude-3-5-sonnet-20241022
AI_TIMEOUT_SECONDS=8

# Voice / transcription
VOICE_PROVIDER=none
OPENAI_API_KEY=
ASSEMBLYAI_API_KEY=

# Safety and checks
GOOGLE_SAFE_BROWSING_KEY=
MAX_CHECKS_PER_USER_PER_HOUR=20
MAX_IMAGE_SIZE_MB=5
MAX_AUDIO_SIZE_MB=10

# Optional Telegram bot settings
WEBHOOK_ENABLED=false
